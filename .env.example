# Copy this file to .env

# --- Postgres 
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=in_video_ad_platform

# --- Backend ---
NODE_ENV=
PORT=
DATABASE_URL=
# Origin allowed to call the API
CORS_ORIGIN=
# Signs/verifies admin login tokens
JWT_SECRET=
# From your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, comma-separated - only set this if your machine's own DNS resolver is 
# broken/unreliable and Cloudinary calls are failing/hanging because of it. Leave unset otherwise.
DNS_FALLBACK_SERVERS=
